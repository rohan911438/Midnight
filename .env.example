NETWORK=preview
NETWORK_ID=preview

# Blockfrost Midnight preview network - get a project id at https://blockfrost.io
BLOCKFROST_PROJECT_ID=your-blockfrost-preview-project-id
MIDNIGHT_INDEXER_HTTP=https://midnight-preview.blockfrost.io/api/v0
MIDNIGHT_INDEXER_WS=wss://midnight-preview.blockfrost.io/api/v0/ws
MIDNIGHT_RPC=wss://rpc.midnight-preview.blockfrost.io

# Local Docker proof server: docker run -d -p 6300:6300 --name midnight-proof-server-1 midnightntwrk/proof-server:8.0.3
PROOF_SERVER_URL=http://localhost:6300

# Signer for deploy/backend scripts. Generate with: node wallet/generate-wallet.mjs
WALLET_SEED_FILE=./wallet/preview-wallet.secret.json

# Filled in by scripts/deploy.mjs once the contract is deployed.
CONTRACT_ADDRESS=

BLOCKSCOUT_URL=https://explorer.preview.midnight.network

BACKEND_PORT=4000
